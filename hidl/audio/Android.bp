soong_namespace {
}

prebuilt_etc {
    name: "android.hardware.audio.service.mediatek.rc",
    src: "android.hardware.audio.service.mediatek.rc",
    sub_dir: "init",
    vendor: true,
}

cc_binary {
    name: "android.hardware.audio.service.mediatek",
    srcs: ["service.cpp"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    shared_libs: [
        "libcutils",
        "libbinder",
        "libbinder_ndk",
        "libhidlbase",
        "liblog",
        "libutils",
        "libhardware",
    ],
    required: [
        "android.hardware.audio.service.mediatek.rc",
    ],
    compile_multilib: "32",
    relative_install_path: "hw",
    vendor: true,
}
