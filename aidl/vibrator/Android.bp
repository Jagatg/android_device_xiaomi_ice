cc_binary {
    name: "android.hardware.vibrator-service.mediatek",
    vintf_fragments: ["android.hardware.vibrator.mediatek.xml"],
    init_rc: ["vibrator-mediatek.rc"],
    vendor: true,
    relative_install_path: "hw",
    cflags: select(soong_config_variable("mediatek_vibrator", "supports_effects"), {
        true: ["-DVIBRATOR_SUPPORTS_EFFECTS"],
        default: [],
    }),
    srcs: [
        "Vibrator.cpp",
        "VibratorUtils.cpp",
        "main.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "android.hardware.vibrator-V2-ndk",
    ],
}
