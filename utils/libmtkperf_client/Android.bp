soong_namespace {
}

cc_defaults {
    name: "libmtkperf_client_defaults",
    srcs: ["mtkperf_client.c"],
    shared_libs: ["liblog"],
}

cc_defaults {
    name: "libpowerhalwrap_defaults",
    srcs: ["powerhalwrap_vendor.c"],
    shared_libs: ["liblog"],
}

cc_library_shared {
    name: "libmtkperf_client_vendor",
    installable: true,
    defaults: ["libmtkperf_client_defaults"],
    vendor: true,
}

cc_library_shared {
    name: "libpowerhalwrap_vendor",
    installable: true,
    defaults: ["libpowerhalwrap_defaults"],
    vendor: true,
}

cc_library_shared {
    name: "libperfctl_vendor",
    installable: true,
    vendor: true,
    srcs: ["perfctl_vendor.c"],
    shared_libs: ["liblog"],
}
